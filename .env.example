# ==============================================================================
# OrbitDeck Environment Configuration
# ==============================================================================

# Server Network Settings
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database Engine Selection: 'sqlite' (default) | 'postgres' | 'mysql'
DB_ENGINE=sqlite

# SQLite Configuration (Default)
DB_PATH=./data/orbitdeck.sqlite
DB_RUN_MIGRATIONS=true

# PostgreSQL Configuration (When DB_ENGINE=postgres)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=orbitdeck
# DB_USER=orbitdeck
# DB_PASSWORD=orbitdeck_secret
# DB_SSL=false

# MySQL Configuration (When DB_ENGINE=mysql)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=orbitdeck
# DB_USER=orbitdeck
# DB_PASSWORD=orbitdeck_secret

# TLE Automatic Refresh Configuration
TLE_AUTO_REFRESH=true
TLE_CRON_SCHEDULE=0 0 * * *
CELESTRAK_BASE_URL=https://celestrak.org/NORAD/elements/gp.php

# SatNOGS Database API
SATNOGS_API_BASE=https://db.satnogs.org/api

# Hamlib TCP Bridge (rigctld & rotctld)
HAMLIB_ENABLED=false
HAMLIB_RIG_HOST=localhost
HAMLIB_RIG_PORT=4532
HAMLIB_ROT_HOST=localhost
HAMLIB_ROT_PORT=4533
HAMLIB_UPDATE_INTERVAL_MS=1000

# Frontend Static Assets Path (for production single-container serving)
# WEB_STATIC_PATH=../web/dist
